# ---- Build Stage ----
FROM node:18-alpine AS build
WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source code and build the React app
COPY . .
RUN npm run build

# ---- Serve Stage ----
FROM nginx:alpine

# Copy the built assets to Nginx's default public folder
COPY --from=build /app/dist /usr/share/nginx/html
# (Note: If using Create React App instead of Vite, change /app/dist to /app/build)

# Expose port 80
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
